# 이 파일을 .env 로 복사해서 값을 채운 뒤 yarn dev 재시작

# 사진 + 기억 분석 (OpenAI 또는 Gemini 중 하나 이상)
OPENAI_API_KEY=
GEMINI_API_KEY=

# openai | gemini | auto
SENSORY_VISION_PROVIDER=openai

# Lyria 음악 생성 (GEMINI_API_KEY 필수, AI Studio 선불 크레딧 필요)
# 비우면 이미지 포함 요청은 lyria-3.5
LYRIA_MODEL=lyria-3-clip-preview

# 선택: 분석 모델 바꾸기
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_VISION_MODEL=gemini-2.5-flash
